# Environnement d'exécution de l'application.
APP_ENV=development


# Configuration PostgreSQL principale.
POSTGRES_DB=orderops                    # Nom de la base de données.
POSTGRES_USER=orderops                  # Utilisateur PostgreSQL.
POSTGRES_PASSWORD=                      # Mot de passe local de développement uniquement.
POSTGRES_PORT=5432                      # Port PostgreSQL exposé localement.

# URL utilisée par SQLAlchemy avec le driver Psycopg.
DATABASE_URL=postgresql+psycopg://orderops:orderops_dev_password@127.0.0.1:5432/orderops

# URL PostgreSQL utilisée par LangGraph pour sauvegarder l'état des conversations.
CHECKPOINT_DATABASE_URL=postgresql://orderops:orderops_dev_password@127.0.0.1:5432/orderops?sslmode=disable


# Configuration du serveur MCP qui expose les tools métier.
MCP_HOST=127.0.0.1                      # Local ; Compose utilise 0.0.0.0 dans le conteneur.
MCP_PORT=8001                           # Port du serveur MCP.
MCP_URL=http://127.0.0.1:8001/mcp      # URL utilisée par l'agent pour appeler MCP.

# Simulation locale de profils, PAS une authentification. Ne pas exposer publiquement.
DEMO_MODE=true
MCP_INTERNAL_TOKEN=orderops-local-demo-only


# Configuration de l'API Mistral.
# Renseigner la vraie clé uniquement dans .env, jamais dans ce modèle.
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest # Modèle utilisé par l'agent.
MISTRAL_EMBED_MODEL=mistral-embed       # Modèle utilisé pour les embeddings du RAG.


# Configuration LangSmith pour les traces, le debug et les évaluations.
LANGSMITH_TRACING=false                 # Passer à true après avoir renseigné la clé.
# Clé API LangSmith optionnelle, à renseigner uniquement dans .env.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orderops-ai-agent     # Nom du projet affiché dans LangSmith.

# Endpoint européen optionnel pour LangSmith.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com


# URL de FastAPI appelée par l'interface Streamlit.
ORDEROPS_API_URL=http://127.0.0.1:8000
